# Copie este arquivo para .env.local e preencha os valores.

# Endereço público do app (sem barra no final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta: usada só no servidor (webhook do Stripe). Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Developers > API keys) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# IDs dos preços mensais criados no Stripe (Product catalog)
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_MULTI=price_...
# Cupom do preço Founders (opcional). Ex.: cupom com valor fixo de desconto, duração "forever".
STRIPE_COUPON_FOUNDERS_BASIC=
STRIPE_COUPON_FOUNDERS_PRO=

# --- Claude (console.anthropic.com > API keys) ---
# Sem esta chave, a estratégia é gerada em modo demonstração.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# E-mails (Resend). Sem a chave, o app funciona e só não envia e-mails.
RESEND_API_KEY=
EMAIL_FROM=1loop creators <contato@1loopcreators.com.br>
EMAIL_REPLY_TO=contato@1loopcreators.com.br
